			)
			(justify left bottom)
		)
		(uuid "a00b075c-f196-4e2b-b4a3-2bb63a78a40b")
	)
	(text "disappears when the target is off. VOUT33 powers the transceiver. Pin allocation in docs/hardware-spec.md."
