	(text "SBC DEVELOPMENT BASEBOARD - schematic first pass, generated 2026-10-04"
		(exclude_from_sim no)
		(at 30 175 0)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "e484ac9d-cd6c-4872-9dbe-2e045cb0af9b")
	)
	(text "One board for remote development on an attached SBC: K64 as USB HID to the target and Ethernet to the workstation,"
		(exclude_from_sim no)
		(at 30 178.2 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "a7e778a4-712d-4abc-aeeb-64727cefd6fc")
	)
	(text "four switched USB-A ports, FT231X FTDI header, two isolated SPDT signal relays, level-shifted console and GPIO/I2C,"
		(exclude_from_sim no)
		(at 30 181.4 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "b53e49a9-9fa9-43b2-8fb1-cfbd0232ecf7")
	)
	(text "switched +5V_TGT eFuse, and an isolated PSU passthrough on a 5 A relay. 140 x 80 mm, four M3 at 10 mm from each corner."
		(exclude_from_sim no)
		(at 30 184.6 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "78e7556f-bb7a-43e4-82ef-c2f585409875")
	)
	(text ""
		(exclude_from_sim no)
		(at 30 187.8 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "d04598d0-d4b6-47f1-8438-d3908a3a835b")
	)
	(text "VERIFY BEFORE FAB (also in docs/hardware-spec.md section 8):"
		(exclude_from_sim no)
		(at 30 191 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "a2281096-bf95-4387-83d0-e1206c8822f6")
	)
	(text "  - K803 JW1FSN contact pad mapping (COM 6 / NO 4 / NC 2) against the Panasonic drawing"
		(exclude_from_sim no)
		(at 30 194.2 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "a673a414-49c6-467d-ac67-7643dd33e815")
	)
	(text "  - DAPLink k20dx HIC pin assignments (SWCLK PTC5, SWDIO PTC6, nRESET PTB1, LED PTD4, UART1 PTC3/4)"
		(exclude_from_sim no)
		(at 30 197.4 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "8dbe5655-eecc-404c-8af8-d1442e7d3eac")
	)
	(text "  - TPS54560B compensation values; TPS2553 ILIM at bring-up; TPS26630 UVLO/ILIM"
		(exclude_from_sim no)
		(at 30 200.6 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "07f5b90c-721c-4494-a7cf-c60ecf361a03")
	)
	(text "  - STUSB4500 operation from VSYS alone (J17 programmer, no VBUS); PCA9517A isolation with VCC(B) = 0"
		(exclude_from_sim no)
		(at 30 203.8 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "48a84867-ce9c-44bb-8cd8-dcf9eafa92a1")
	)
	(text "  - USB2517 VBUS_DET divider (10k/22k) vs the EVB; LED_A/B strap pull-downs"
