	(text "SBC DEVELOPMENT BASEBOARD - schematic first pass, generated 2026-10-04"
		(exclude_from_sim no)
		(at 30 175 0)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "fb571b82-f444-4b98-a3e4-51afe30c9a7d")
	)
	(text "One board for remote development on an attached SBC: K64 as USB HID to the target and Ethernet to the workstation,"
		(exclude_from_sim no)
		(at 30 178.2 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "073ae2c1-df7d-4253-8a5c-431a168ed117")
	)
	(text "four switched USB-A ports, FT231X FTDI header, two isolated SPDT signal relays, level-shifted console and GPIO/I2C,"
		(exclude_from_sim no)
		(at 30 181.4 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "3cf346c7-6195-4128-a8b2-af0fdd5b9ec6")
	)
	(text "switched +5V_TGT eFuse, and an isolated PSU passthrough on a 5 A relay. 140 x 80 mm, four M3 at 10 mm from each corner."
		(exclude_from_sim no)
		(at 30 184.6 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "9e4d8cbe-82c1-403d-b235-552f0a21fab3")
	)
	(text ""
		(exclude_from_sim no)
		(at 30 187.8 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "18c1e729-c8a9-4325-aa77-9e1c36b6d304")
	)
	(text "VERIFY BEFORE FAB (also in docs/hardware-spec.md section 8):"
		(exclude_from_sim no)
		(at 30 191 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "706dc40c-774c-4a49-b0bc-c2475c33f081")
	)
	(text "  - K803 JW1FSN contact pad mapping (COM 6 / NO 4 / NC 2) against the Panasonic drawing"
		(exclude_from_sim no)
		(at 30 194.2 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "d0a078c6-7a91-4363-8f5b-052b5b860bc1")
	)
	(text "  - DAPLink k20dx HIC pin assignments (SWCLK PTC5, SWDIO PTC6, nRESET PTB1, LED PTD4, UART1 PTC3/4)"
		(exclude_from_sim no)
		(at 30 197.4 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "0c5c888b-c423-4b3f-adbb-a046c3334e59")
	)
	(text "  - TPS54560B compensation values; TPS2553 ILIM at bring-up; TPS26630 UVLO/ILIM"
		(exclude_from_sim no)
		(at 30 200.6 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "bdfd5463-dc3c-461b-9241-df34bc429055")
	)
	(text "  - STUSB4500 operation from VSYS alone (J17 programmer, no VBUS); PCA9517A isolation with VCC(B) = 0"
		(exclude_from_sim no)
		(at 30 203.8 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "3cbbbc40-6bb2-4f0b-b4bc-a9904855f769")
	)
	(text "  - USB2517 VBUS_DET divider (10k/22k) vs the EVB; LED_A/B strap pull-downs"
