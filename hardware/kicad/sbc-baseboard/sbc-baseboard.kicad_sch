		(uuid "42d8c230-bff3-4064-8664-e1898462e95a")
	)
	(text "  - DAPLink k20dx HIC pin assignments (SWCLK PTC5, SWDIO PTC6, nRESET PTB1, LED PTD4, UART1 PTC3/4)"
		(exclude_from_sim no)
		(at 30 197.4 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "0d2eae82-3307-4051-aa34-a1d03959b2a3")
	)
	(text "  - TPS54560B compensation values; TPS2553 ILIM at bring-up; TPS26630 UVLO/ILIM"
		(exclude_from_sim no)
		(at 30 200.6 0)
		(effects
			(font
