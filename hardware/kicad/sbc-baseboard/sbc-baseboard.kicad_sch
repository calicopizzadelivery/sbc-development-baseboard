	(text "SBC DEVELOPMENT BASEBOARD - schematic first pass, generated 2026-10-04"
		(exclude_from_sim no)
		(at 30 175 0)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "553c75d8-be41-47aa-8489-0037134a9934")
	)
	(text "One board for remote development on an attached SBC: K64 as USB HID to the target and Ethernet to the workstation,"
		(exclude_from_sim no)
		(at 30 178.2 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "b530e5cf-37ba-48ab-9723-15e8cbe4bea4")
	)
	(text "four switched USB-A ports, FT231X FTDI header, two isolated SPDT signal relays, level-shifted console and GPIO/I2C,"
		(exclude_from_sim no)
		(at 30 181.4 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "0c08f4ae-cd4f-4d6b-aa85-7bbf8704b10d")
	)
	(text "switched +5V_TGT eFuse, and an isolated PSU passthrough on a 5 A relay. 140 x 80 mm, four M3 at 10 mm from each corner."
		(exclude_from_sim no)
		(at 30 184.6 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "8c5590a4-7112-4962-818f-ee8d2c0f61ab")
	)
	(text ""
		(exclude_from_sim no)
		(at 30 187.8 0)
		(effects
