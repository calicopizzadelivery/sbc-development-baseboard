		(at 30 203.8 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "18647ea8-7679-4195-8f63-09d1582be743")
	)
	(text "  - USB2517 VBUS_DET divider (10k/22k) vs the EVB; LED_A/B strap pull-downs"
