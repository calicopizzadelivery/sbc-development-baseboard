	(text "SBC DEVELOPMENT BASEBOARD - schematic first pass, generated 2026-10-04"
		(exclude_from_sim no)
		(at 30 175 0)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "6498bf00-ecc3-42b3-acdf-38a452efaafd")
	)
	(text "One board for remote development on an attached SBC: K64 as USB HID to the target and Ethernet to the workstation,"
		(exclude_from_sim no)
		(at 30 178.2 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "0a42f888-2ee7-4340-be08-a2bb0abd1ba9")
	)
	(text "four switched USB-A ports, FT231X FTDI header, two isolated SPDT signal relays, level-shifted console and GPIO/I2C,"
		(exclude_from_sim no)
		(at 30 181.4 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "9f9060b3-a665-4ed2-81d3-7d4a481abd30")
	)
	(text "switched +5V_TGT eFuse, and an isolated PSU passthrough on a 5 A relay. 140 x 80 mm, four M3 at 10 mm from each corner."
		(exclude_from_sim no)
		(at 30 184.6 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "ee61dfb7-f3a0-46d4-be10-a4a4f8002e29")
	)
	(text ""
