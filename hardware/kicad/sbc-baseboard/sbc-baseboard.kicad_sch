		(uuid "a7d75345-56fd-41d5-9197-96eea431cba9")
	)
	(text "  - K803 JW1FSN contact pad mapping (COM 6 / NO 4 / NC 2) against the Panasonic drawing"
		(exclude_from_sim no)
		(at 30 194.2 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "59575903-4ffc-4ba9-a213-5d059c2d611e")
	)
	(text "  - DAPLink k20dx HIC pin assignments (SWCLK PTC5, SWDIO PTC6, nRESET PTB1, LED PTD4, UART1 PTC3/4)"
		(exclude_from_sim no)
		(at 30 197.4 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "4c828a9d-04a3-4cde-8f9d-eb444e1b9e3e")
	)
	(text "  - TPS54560B compensation values; TPS2553 ILIM at bring-up; TPS26630 UVLO/ILIM"
		(exclude_from_sim no)
		(at 30 200.6 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "11f9c90b-2ed1-4b6d-86db-dc5cf564bf78")
	)
	(text "  - STUSB4500 operation from VSYS alone (J17 programmer, no VBUS); PCA9517A isolation with VCC(B) = 0"
