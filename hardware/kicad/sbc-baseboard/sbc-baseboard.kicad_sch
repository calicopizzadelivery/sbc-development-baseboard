	(text "SBC DEVELOPMENT BASEBOARD - schematic first pass, generated 2026-10-04"
		(exclude_from_sim no)
		(at 30 175 0)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "0909239f-53ca-4829-955e-1113420eb194")
	)
	(text "One board for remote development on an attached SBC: K64 as USB HID to the target and Ethernet to the workstation,"
		(exclude_from_sim no)
		(at 30 178.2 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "458976ea-fad5-4b9a-80c3-08f372aff73b")
	)
	(text "four switched USB-A ports, FT231X FTDI header, two isolated SPDT signal relays, level-shifted console and GPIO/I2C,"
		(exclude_from_sim no)
		(at 30 181.4 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "9d7c8f4e-00c4-4562-8c53-edea514d9664")
	)
	(text "switched +5V_TGT eFuse, and an isolated PSU passthrough on a 5 A relay. 140 x 80 mm, four M3 at 10 mm from each corner."
		(exclude_from_sim no)
		(at 30 184.6 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "761838ab-6c00-4254-8b26-695e0488493a")
	)
	(text ""
		(exclude_from_sim no)
		(at 30 187.8 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "2920d30d-4452-4cfd-a428-3ed3172c42ee")
	)
	(text "VERIFY BEFORE FAB (also in docs/hardware-spec.md section 8):"
		(exclude_from_sim no)
		(at 30 191 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "26d824a5-c993-43d3-bc9e-c7fd7929dbfe")
	)
	(text "  - K803 JW1FSN contact pad mapping (COM 6 / NO 4 / NC 2) against the Panasonic drawing"
		(exclude_from_sim no)
		(at 30 194.2 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "87eafe5b-3711-4462-8a87-5d924ba6d176")
	)
	(text "  - DAPLink k20dx HIC pin assignments (SWCLK PTC5, SWDIO PTC6, nRESET PTB1, LED PTD4, UART1 PTC3/4)"
		(exclude_from_sim no)
		(at 30 197.4 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "38038642-c491-4363-a37f-665956c71c77")
	)
	(text "  - TPS54560B compensation values; TPS2553 ILIM at bring-up; TPS26630 UVLO/ILIM"
		(exclude_from_sim no)
		(at 30 200.6 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "279dbb2f-c327-47f6-86a0-133e86f64d1e")
	)
	(text "  - STUSB4500 operation from VSYS alone (J17 programmer, no VBUS); PCA9517A isolation with VCC(B) = 0"
		(exclude_from_sim no)
		(at 30 203.8 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "d68ca0f2-0063-4217-a2dd-c362e949cad3")
	)
	(text "  - USB2517 VBUS_DET divider (10k/22k) vs the EVB; LED_A/B strap pull-downs"
		(exclude_from_sim no)
		(at 30 207 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "f284c627-6728-40cc-a343-6d195f84afb2")
	)
	(text "  - KSZ8081 crystal load (22 pF) and 50 MHz REF_CLK series resistor"
