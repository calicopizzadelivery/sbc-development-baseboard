		(at 30 191 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "a4c2573d-6739-598c-8cfe-8d96e59d78e2")
	)
	(text "  - K803 JW1FSN contact pad mapping (COM 6 / NO 4 / NC 2) against the Panasonic drawing"
		(exclude_from_sim no)
		(at 30 194.2 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "673732ca-2939-5094-ab2e-760e067b9f53")
	)
	(text "  - DAPLink K20: pins verified against DAPLink k20dx and the FRDM-K64F OpenSDA circuit; confirm SWD at bring-up"
		(exclude_from_sim no)
		(at 30 197.4 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "3e922aea-f927-59f8-87f7-1d308041a5b9")
	)
	(text "  - TPS54560B compensation values; TPS2553 ILIM at bring-up; TPS26630 UVLO/ILIM"
		(exclude_from_sim no)
		(at 30 200.6 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "ced4af91-49f4-5b0c-9f11-63ecd5133573")
	)
	(text "  - STUSB4500 operation from VSYS alone (J17 programmer, no VBUS); PCA9517A isolation with VCC(B) = 0"
		(exclude_from_sim no)
		(at 30 203.8 0)
		(effects
			(font
				(size 1.6 1.6)
			)
