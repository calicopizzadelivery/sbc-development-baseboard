		(uuid "001297f5-d1a4-4d88-9030-a2945f22ebeb")
	)
	(text "Pinout = TTL-232R / SparkFun: 1 GND (blk)  2 CTS (brn)  3 VCC (red)  4 TXD (org)  5 RXD (yel)  6 RTS/DTR (grn)."
		(exclude_from_sim no)
		(at 16 19.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "f79eacbd-f33f-4dc3-b509-8da83dd3cd6c")
	)
	(text "TXD/RXD named from the FT231X side: TXD drives the target's RX. 3.3 V levels only; 1.8 V consoles use J13."
		(exclude_from_sim no)
		(at 16 22.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "fa10d92c-d11c-4b58-8e5e-df1fa51f4d27")
	)
	(text "JP501: pin 6 = DTR# (bridge C-A, default) or RTS# (bridge C-B). JP502: pin 3 VCC from 3V3OUT (50 mA), open by default."
		(exclude_from_sim no)
		(at 16 25.1 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "cf003629-01b9-434d-b230-0aafc265c036")
	)
	(text "VCC comes from the TPS2553 on the hub sheet (FTDI_VBUS): FTDI CYCLE power-cycles the bridge without a replug."
		(exclude_from_sim no)
		(at 16 27.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "4ce24acd-a8f9-458f-911b-1116bf2778be")
	)
	(text "CBUS defaults: CBUS1 = RXLED#, CBUS2 = TXLED# (factory MTP); change with FT_PROG if ever needed."
		(exclude_from_sim no)
		(at 16 30.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "4c300b53-d8be-4924-92d6-43a942e41ac3")
	)
