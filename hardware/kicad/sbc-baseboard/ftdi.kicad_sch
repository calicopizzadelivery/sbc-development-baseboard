	(text "FTDI HEADER J9"
		(exclude_from_sim no)
		(at 15 15 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "f826eb50-6ed9-4d30-9d5f-522ed58c26ad")
	)
	(text "Pinout = TTL-232R / SparkFun: 1 GND (blk)  2 CTS (brn)  3 VCC (red)  4 TXD (org)  5 RXD (yel)  6 RTS/DTR (grn)."
		(exclude_from_sim no)
		(at 15 17.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "e4610c22-07a2-4a9b-be5e-1fdbc6856ac5")
	)
	(text "TXD/RXD named from the FT231X side: TXD drives the target's RX. 3.3 V levels only; 1.8 V consoles use J13."
		(exclude_from_sim no)
		(at 15 20.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "6841936d-19f6-4847-8e71-4b89a55d556b")
	)
	(text "JP501: pin 6 = DTR# (bridge C-A, default) or RTS# (bridge C-B). JP502: pin 3 VCC from 3V3OUT (50 mA), open by default."
		(exclude_from_sim no)
		(at 15 23.1 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "6ec062ea-7188-4091-8d13-0e080dc960c6")
	)
	(text "VCC comes from the TPS2553 on the hub sheet (FTDI_VBUS): FTDI CYCLE power-cycles the bridge without a replug."
		(exclude_from_sim no)
		(at 15 25.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "9c4832bd-3536-4636-8122-0e4adf53ced7")
	)
	(text "CBUS defaults: CBUS1 = RXLED#, CBUS2 = TXLED# (factory MTP); change with FT_PROG if ever needed."
		(exclude_from_sim no)
		(at 15 28.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "0fd1ae96-4557-4d32-8eb9-9debf599b979")
	)
