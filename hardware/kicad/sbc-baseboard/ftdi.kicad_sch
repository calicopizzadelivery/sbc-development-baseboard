		(uuid "0e8aaa44-cf18-42d6-a00b-75499cbe8d8e")
	)
	(text "Pinout = TTL-232R / SparkFun: 1 GND (blk)  2 CTS (brn)  3 VCC (red)  4 TXD (org)  5 RXD (yel)  6 RTS/DTR (grn)."
		(exclude_from_sim no)
		(at 16 19.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "c6baa120-bd42-4af0-9b1e-d9d48695a718")
	)
	(text "TXD/RXD named from the FT231X side: TXD drives the target's RX. 3.3 V levels only; 1.8 V consoles use J13."
		(exclude_from_sim no)
		(at 16 22.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "f4ee2baf-c792-4bc2-9ee2-4807e826a9cc")
	)
	(text "JP501: pin 6 = DTR# (bridge C-A, default) or RTS# (bridge C-B). JP502: pin 3 VCC from 3V3OUT (50 mA), open by default."
		(exclude_from_sim no)
		(at 16 25.1 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "4ba57f38-7106-4de9-be22-ae6614e14b0e")
	)
	(text "VCC comes from the TPS2553 on the hub sheet (FTDI_VBUS): FTDI CYCLE power-cycles the bridge without a replug."
		(exclude_from_sim no)
		(at 16 27.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "57cbd27d-8fb1-4e3a-be8f-57f667c1e617")
	)
	(text "CBUS defaults: CBUS1 = RXLED#, CBUS2 = TXLED# (factory MTP); change with FT_PROG if ever needed."
		(exclude_from_sim no)
		(at 16 30.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "03ba4f47-da6e-43c1-b66e-73fecb110024")
	)
