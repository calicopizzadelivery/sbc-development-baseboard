		(uuid "bb2e5b7d-dbff-4dba-8d90-d68b5f73f0ad")
	)
	(text "Pinout = TTL-232R / SparkFun: 1 GND (blk)  2 CTS (brn)  3 VCC (red)  4 TXD (org)  5 RXD (yel)  6 RTS/DTR (grn)."
		(exclude_from_sim no)
		(at 15 17.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "5105cac7-5d20-490c-94bb-9ed5ce10757e")
	)
	(text "TXD/RXD named from the FT231X side: TXD drives the target's RX. 3.3 V levels only; 1.8 V consoles use J13."
		(exclude_from_sim no)
		(at 15 20.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "a06b71b4-b5c6-4055-84ec-c4870c554c60")
	)
	(text "JP501: pin 6 = DTR# (bridge C-A, default) or RTS# (bridge C-B). JP502: pin 3 VCC from 3V3OUT (50 mA), open by default."
		(exclude_from_sim no)
		(at 15 23.1 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "ce7ba91e-5953-48ae-baec-be14c148ef03")
	)
	(text "VCC comes from the TPS2553 on the hub sheet (FTDI_VBUS): FTDI CYCLE power-cycles the bridge without a replug."
		(exclude_from_sim no)
		(at 15 25.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7580890d-562c-4fb8-bb13-b155acb02b79")
	)
	(text "CBUS defaults: CBUS1 = RXLED#, CBUS2 = TXLED# (factory MTP); change with FT_PROG if ever needed."
		(exclude_from_sim no)
		(at 15 28.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7e883550-8a99-4b8e-bfe9-58ef63af0367")
	)
