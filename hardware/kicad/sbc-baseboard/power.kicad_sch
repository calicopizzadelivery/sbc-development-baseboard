	(text "POWER"
		(exclude_from_sim no)
		(at 16 17 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "fc3998b5-a2df-5e19-9d98-432fa28f3420")
	)
	(text "J2: 2.5 x 5.5 mm barrel jack, centre positive, for a 5 V 4 A (20 W) adapter (2026-10-10; a USB-C PD inlet with two"
		(exclude_from_sim no)
		(at 16 19.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "53ecf201-cd65-5313-8ce0-2c57f32e06d8")
	)
	(text "5 V bucks until then). SMAJ5.0A clamps the inlet; Q101, a P-channel MOSFET with its body diode toward the rail and its"
		(exclude_from_sim no)
		(at 16 22.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "053b06d9-f54d-5760-b531-858177dd61d7")
	)
	(text "gate at GND, blocks reverse polarity at 9.5 mOhm. No series fuse: the adapter limits the inlet, the eFuse the target rail,"
		(exclude_from_sim no)
		(at 16 25.1 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "09f47338-0e30-55e2-a22e-92d2580a4623")
	)
	(text "the TPS2553s the ports. The adapter's 4 A is the only limit on the sum: the ports (4 x 1.1 A), the target rail (3 A) and the"
		(exclude_from_sim no)
		(at 16 27.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "c73f3290-6db3-57af-b2df-12740311e946")
	)
	(text "board (0.5 A) can ask for more together; firmware keeps the budget (docs/hardware-spec.md section 4)."
		(exclude_from_sim no)
		(at 16 30.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "22f8d88a-a291-560d-a204-599ffdc7aa91")
	)
	(text "+5V is laid out for 4 A (class PWR_4A, 2.5 mm or pours); +5V_TGT leaves the eFuse at up to 3 A in the same class."
		(exclude_from_sim no)
		(at 16 33.2 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "fabd0a5c-a86f-5c77-83a8-1eac8f3bc0e8")
	)
