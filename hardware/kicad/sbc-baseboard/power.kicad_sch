		(uuid "a589601f-1cd4-4bb5-b92b-d5e2abf1ee0e")
	)
	(text "J2 is a PD sink only (no data). STUSB4500 negotiates from NVM; VBUS_EN_SNK gates the 5 V bucks through Q101,"
		(exclude_from_sim no)
		(at 16 19.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "9d30e594-bef8-44e9-a43c-348f17bab5ea")
	)
	(text "so the rails only come up once a sink contract (or plain Type-C 5 V) is valid. No series VBUS FET."
		(exclude_from_sim no)
		(at 16 22.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "fe66e9a1-0c10-4dca-b7ab-e4ab4d6580a3")
	)
	(text "J17 (Qwiic) programs the STUSB4500 NVM and powers it through VSYS when the board is dead."
		(exclude_from_sim no)
		(at 16 25.1 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "da83ba33-9ca8-4692-9f39-c2d4bba0df49")
	)
	(text "PCA9517A: A side = PD segment (+3V3_PD, diode-OR of +3V3 and the programmer), B side = K64 I2C0."
		(exclude_from_sim no)
		(at 16 27.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "decb67b8-aab2-4ac5-9235-8d29165f7e5f")
	)
	(text "A programmer on J17 pulls PCA_EN low through Q102: the K64 is disconnected from the PD bus in hardware."
		(exclude_from_sim no)
		(at 16 30.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "f0f61cfe-437d-4a60-bf75-16c6c6faaf90")
	)
