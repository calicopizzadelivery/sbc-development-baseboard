	)
	(text "J2 is a PD sink only (no data). STUSB4500 negotiates from NVM; VBUS_EN_SNK gates the 5 V bucks through Q101,"
		(exclude_from_sim no)
		(at 16 19.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "aa17f3c3-fa3a-42a4-b146-e70ff6042d70")
	)
	(text "so the rails only come up once a sink contract (or plain Type-C 5 V) is valid. No series VBUS FET."
		(exclude_from_sim no)
		(at 16 22.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "332f012c-fb7b-4a21-afa5-cdde2594382b")
	)
	(text "J17 (Qwiic) programs the STUSB4500 NVM and powers it through VSYS when the board is dead."
		(exclude_from_sim no)
		(at 16 25.1 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "c991be96-0bac-4937-b440-3eed16754213")
	)
	(text "PCA9517A: A side = PD segment (+3V3_PD, diode-OR of +3V3 and the programmer), B side = K64 I2C0."
		(exclude_from_sim no)
		(at 16 27.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "11a6c341-b9df-402e-bca6-b77579e5641a")
	)
	(text "A programmer on J17 pulls PCA_EN low through Q102: the K64 is disconnected from the PD bus in hardware."
		(exclude_from_sim no)
		(at 16 30.5 0)
		(effects
