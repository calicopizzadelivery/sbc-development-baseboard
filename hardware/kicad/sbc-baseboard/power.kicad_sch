	(text "POWER"
		(exclude_from_sim no)
		(at 15 15 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "81168bbe-f499-432d-90d7-a5229587958d")
	)
	(text "J2 is a PD sink only (no data). STUSB4500 negotiates from NVM; VBUS_EN_SNK gates the 5 V bucks through Q101,"
		(exclude_from_sim no)
		(at 15 17.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "bf80852a-f75f-4318-b7c1-a1a38eeb1701")
	)
	(text "so the rails only come up once a sink contract (or plain Type-C 5 V) is valid. No series VBUS FET."
		(exclude_from_sim no)
		(at 15 20.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "65262a3b-6653-408d-9915-ec1785159e72")
	)
	(text "J17 (Qwiic) programs the STUSB4500 NVM and powers it through VSYS when the board is dead."
		(exclude_from_sim no)
		(at 15 23.1 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "9e056123-a8ad-4281-b604-9c988c802e1a")
	)
	(text "PCA9517A: A side = PD segment (+3V3_PD, diode-OR of +3V3 and the programmer), B side = K64 I2C0."
		(exclude_from_sim no)
		(at 15 25.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "16e02717-9bba-43ca-b064-6b52da989207")
	)
	(text "A programmer on J17 pulls PCA_EN low through Q102: the K64 is disconnected from the PD bus in hardware."
		(exclude_from_sim no)
		(at 15 28.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "8d6794b6-6566-45e4-a5f6-694148814f18")
	)
