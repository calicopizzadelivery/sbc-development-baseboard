		)
		(uuid "ba869c47-338e-42f5-885f-2ff2083acb80")
	)
	(text "J2 is a PD sink only (no data). STUSB4500 negotiates from NVM; VBUS_EN_SNK gates the 5 V bucks through Q101,"
		(exclude_from_sim no)
		(at 16 19.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "37caddf2-62d7-4907-a0de-8e67cb1eb224")
	)
	(text "so the rails only come up once a sink contract (or plain Type-C 5 V) is valid. No series VBUS FET."
		(exclude_from_sim no)
		(at 16 22.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "ff38771f-353b-4c05-935e-7a1e8d0c616f")
	)
	(text "J17 (Qwiic) programs the STUSB4500 NVM and powers it through VSYS when the board is dead."
		(exclude_from_sim no)
		(at 16 25.1 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "76cdfd57-cebe-4744-9a53-4fa27797d7b8")
	)
	(text "PCA9517A: A side = PD segment (+3V3_PD, diode-OR of +3V3 and the programmer), B side = K64 I2C0."
		(exclude_from_sim no)
		(at 16 27.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "a97f44fe-25fc-42ea-bbee-0425cf1fe8a1")
	)
	(text "A programmer on J17 pulls PCA_EN low through Q102: the K64 is disconnected from the PD bus in hardware."
		(exclude_from_sim no)
		(at 16 30.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "1a1da2bb-ce54-4809-9b61-ea1f91384caf")
	)
