		(uuid "cbbdd124-abc5-4364-aea5-74a86cf4cf99")
	)
	(text "J2 is a PD sink only (no data). STUSB4500 negotiates from NVM; VBUS_EN_SNK gates the 5 V bucks through Q101,"
		(exclude_from_sim no)
		(at 16 19.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "cf998e4f-88b9-4397-b8e4-fb1d62c423bc")
	)
	(text "so the rails only come up once a sink contract (or plain Type-C 5 V) is valid. No series VBUS FET."
		(exclude_from_sim no)
		(at 16 22.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "a0b88895-b588-44b8-bc0f-88f337e69090")
	)
	(text "J17 (Qwiic) programs the STUSB4500 NVM and powers it through VSYS when the board is dead."
		(exclude_from_sim no)
		(at 16 25.1 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "fd085640-07b3-45a5-bbd6-1692ab47fc0b")
	)
	(text "PCA9517A: A side = PD segment (+3V3_PD, diode-OR of +3V3 and the programmer), B side = K64 I2C0."
		(exclude_from_sim no)
		(at 16 27.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7600f4c6-bedb-4c9b-872a-d6cd2cba3463")
	)
	(text "A programmer on J17 pulls PCA_EN low through Q102: the K64 is disconnected from the PD bus in hardware."
		(exclude_from_sim no)
		(at 16 30.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "c750aa1f-99fc-4d79-ada4-f53bb6f19cc5")
	)
