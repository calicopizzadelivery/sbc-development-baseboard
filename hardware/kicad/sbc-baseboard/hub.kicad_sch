	(text "USB HUB"
		(exclude_from_sim no)
		(at 16 17 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "7dee214c-1da6-5192-a168-dc48b09bd379")
	)
	(text "USB2517 strap-configured (CFG_SEL=000), no firmware needed for the USB tree to come up."
		(exclude_from_sim no)
		(at 16 19.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "dd3a0d4e-2052-50af-b0bb-a7dbb6fcadfb")
	)
	(text "Port map: 1 = DAPLink, 2 = FT231X, 3 = disabled (DN3 pulled up), 4..7 = USB-A PORT1..PORT4 (J4A/J4B = PORT1/PORT2 on hub ports 4,5; J5A/J5B = PORT3/PORT4 on ports 6,7)."
		(exclude_from_sim no)
		(at 16 22.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "e084878d-3591-52e9-bf55-7f464ae5321e")
	)
	(text "NON_REM=11 (pin 40 up, pin 45 up) marks ports 1-3 non-removable and LOCAL_PWR high reports self-powered."
		(exclude_from_sim no)
		(at 16 25.1 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "b37c31a5-b31b-54fe-976a-6772f29e0005")
	)
	(text "LED_A/B pins pulled down: PRT_SWP normal polarity, BOOST=00, GANG_EN=0 (individual over-current)."
		(exclude_from_sim no)
		(at 16 27.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "8a06b953-6330-5089-bc1c-16224cf1c0c8")
	)
	(text "Port power is switched by TPS2553 under K64 GPIO (boot ON via pull-ups); PRTPWR outputs unused; /FAULT feeds OCSx_N."
		(exclude_from_sim no)
		(at 16 30.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "5956bf34-4aa4-5915-a583-e21cc298af2f")
	)
	(text "USB 2.0 pairs are named *_P / *_N (KiCad's differential-pair convention) and sit in net class USB: 90 ohm differential, routed as pairs, no stubs. Each ESD array splits its pair into a hub side (HUB_DNn) and a connector side (PORTn_D). Set the class's width and gap from the stackup before routing."
		(exclude_from_sim no)
		(at 16 33.2 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "f356924f-b8b8-5e6b-b678-d08e4abe9a1f")
	)
	(text "Current: PORTn_VBUS and FTDI_VBUS are laid out for 3 A each (class USB_VBUS_3A, 2 mm traces); +5V_PORTS feeds them at up to 6 A (PWR_6A)."
		(exclude_from_sim no)
		(at 16 35.9 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "d0be5918-8424-5d1d-8763-ad84929d784b")
	)
