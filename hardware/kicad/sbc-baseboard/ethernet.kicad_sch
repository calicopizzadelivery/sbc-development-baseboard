	(text "KSZ8081RNA in RMII 25 MHz mode (its power-up default): 25 MHz crystal on XI/XO, REF_CLK outputs 50 MHz"
		(exclude_from_sim no)
		(at 16 19.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "6012bb78-666a-4810-a76c-7d471464647b")
	)
	(text "to the K64 EXTAL0 through R301. This is the FRDM-K64F arrangement (Zephyr: microchip,interface-type = rmii-25MHz)."
		(exclude_from_sim no)
		(at 16 22.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "8e93a23d-962c-4a31-a2ac-7b809594ef50")
	)
	(text "PHY address 0 (pins 15/16 internal pull-downs; the MAC does not drive them). RXER needs the external pull-down."
		(exclude_from_sim no)
		(at 16 25.1 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "f2da9571-41b9-4886-b6ef-c42ecaa702ea")
	)
	(text "Transformer centre taps go to 0.1 uF each, not to a supply (datasheet 11.x). Bob Smith: 4x75R to 1 nF/2 kV."
