		)
		(uuid "783b5d06-46c3-40ae-8c81-2ddff50d8fe1")
	)
	(text "PHY address 0 (pins 15/16 internal pull-downs; the MAC does not drive them). RXER needs the external pull-down."
		(exclude_from_sim no)
